# Template only. Copy to .env and supply your own local credentials.
# The working .env already preserves your existing YouTube API key.

# Docker Hub image reference; no registry password or token belongs here.
DOCKERHUB_NAMESPACE=mohammadashraf97
DOCKERHUB_REPOSITORY=yt_api_elt
IMAGE_TAG=1.0.0

# PostgreSQL bootstrap account and internal Compose network address.
POSTGRES_CONN_USERNAME=postgres
POSTGRES_CONN_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
POSTGRES_CONN_HOST=postgres
POSTGRES_CONN_PORT=5432

# Airflow metadata database.
METADATA_DATABASE_NAME=airflow_metadata_db
METADATA_DATABASE_USERNAME=airflow_meta_user
METADATA_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_METADATA_PASSWORD

# Celery results database.
CELERY_BACKEND_NAME=celery_results_db
CELERY_BACKEND_USERNAME=celery_user
CELERY_BACKEND_PASSWORD=REPLACE_WITH_LOCAL_CELERY_PASSWORD

# YouTube ELT destination database.
ELT_DATABASE_NAME=elt_db
ELT_DATABASE_USERNAME=yt_api_user
ELT_DATABASE_PASSWORD=REPLACE_WITH_LOCAL_ELT_PASSWORD

# Airflow startup settings.
AIRFLOW_UID=50000
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=REPLACE_WITH_LOCAL_AIRFLOW_PASSWORD
FERNET_KEY=REPLACE_WITH_A_VALID_GENERATED_FERNET_KEY

# YouTube API settings.
API_KEY=REPLACE_WITH_YOUR_YOUTUBE_API_KEY
CHANNEL_HANDLE=MrBeast

# Podman bind-mount path for this Windows project.
# Required on this Podman setup because the Windows project path has commas.
# First run: .\docker\prepare-podman-mount.ps1
# On Docker Desktop or another host, omit this to use ordinary relative mounts.
CONTAINER_PROJECT_ROOT=/home/user/yt-elt-project

# Optional Compose overrides. Defaults avoid the older Astro project's ports.
AIRFLOW_WEB_HOST_PORT=8081
POSTGRES_HOST_PORT=5433
FLOWER_HOST_PORT=5556
AIRFLOW_WORKER_CONCURRENCY=2
